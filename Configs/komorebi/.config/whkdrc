.shell pwsh

# Keys follow omarchy, with Super = the Windows key (Win+L lock and Win+R run are left alone).
# The "# ..." at the end of a line is its description in windots-menu-keybindings (Win+K).

# --- Apps ---
win + return         : windots-launch-terminal  # Terminal (windots default terminal)
win + shift + return : start msedge  # Navegador
win + shift + b      : start msedge  # Navegador
win + ctrl + return  : start "$env:LOCALAPPDATA\Programs\herdr-app\herdr-app.exe"  # Herdr
win + shift + f      : windots-launch-files  # Gerenciador de arquivos (Files)
win + shift + n      : windots-launch-terminal nvim  # Editor (nvim)
win + ctrl + q       : start calc  # Calculadora
win + shift + t      : windots-launch-or-focus-tui --float btop  # Monitor de sistema (btop)
win + shift + oem_2  : windots-launch-or-focus --float '^(omapass)$' "$env:LOCALAPPDATA\Programs\omapass\omapass.exe"  # Senhas (omapass); ABNT2 em windots-hotkeys.ahk

# --- Tema, fontes e menus ---
# Win+K (atalhos), Win+Ctrl+T e Win+Ctrl+Shift+Space (temas), Win+Ctrl+W e Win+Ctrl+Space (tela de fundo) abrem o
# windots-launcher e estão em windots-hotkeys.ahk: o whkd abre um pwsh a cada atalho, o AutoHotkey já está rodando.
# Nunca repita essas teclas aqui: o menu abriria e fecharia.
win + ctrl + d      : start ms-settings:display  # Configurações de tela (monitor)

# --- Configurações (omarchy: Super+Ctrl+A/B/N/P) ---
win + ctrl + a       : start ms-settings:sound  # Configurações de som
win + ctrl + b       : start ms-settings:bluetooth  # Configurações de bluetooth
win + ctrl + n       : start ms-settings:network  # Configurações de rede
win + ctrl + p       : start ms-settings:powersleep  # Configurações de energia
win + ctrl + shift + f : windots-install-font  # Instalar fonte (Nerd Fonts)

# --- Captura (Print abre o recorte nativo do Windows) ---
win + ctrl + shift + c : start ms-screenclip:  # Captura de tela (recorte)

# --- Janelas ---
win + w              : komorebic close  # Fechar janela
win + q              : komorebic close  # Fechar janela
win + f              : windots-toggle-fullscreen  # Tela cheia (cobre a barra do Windows)
win + ctrl + f       : komorebic toggle-monocle  # Tela cheia no tile (monocle)
win + t              : komorebic toggle-float  # Alternar flutuante/tile
win + j              : komorebic flip-layout horizontal  # Inverter divisão na horizontal
win + shift + j      : komorebic flip-layout vertical  # Inverter divisão na vertical
win + m              : komorebic minimize  # Minimizar janela
win + e              : komorebic retile  # Reorganizar janelas (retile)

# --- Foco (Win+setas) ---
win + left           : komorebic focus left  # Focar janela à esquerda
win + right          : komorebic focus right  # Focar janela à direita
win + up             : komorebic focus up  # Focar janela acima
win + down           : komorebic focus down  # Focar janela abaixo

# --- Trocar janelas de lugar (Win+Shift+setas) ---
win + shift + left   : komorebic move left  # Mover janela para a esquerda
win + shift + right  : komorebic move right  # Mover janela para a direita
win + shift + up     : komorebic move up  # Mover janela para cima
win + shift + down   : komorebic move down  # Mover janela para baixo

# --- Redimensionar (Win+-/= na largura, Win+Shift+-/= na altura) ---
win + oem_minus         : komorebic resize-axis horizontal decrease  # Diminuir largura
win + oem_plus          : komorebic resize-axis horizontal increase  # Aumentar largura
win + shift + oem_minus : komorebic resize-axis vertical decrease  # Diminuir altura
win + shift + oem_plus  : komorebic resize-axis vertical increase  # Aumentar altura

# --- Workspaces ---
win + tab            : komorebic cycle-workspace next  # Próximo workspace
win + shift + tab    : komorebic cycle-workspace previous  # Workspace anterior

win + 1              : komorebic focus-workspace 0  # Ir para o workspace 1
win + 2              : komorebic focus-workspace 1  # Ir para o workspace 2
win + 3              : komorebic focus-workspace 2  # Ir para o workspace 3
win + 4              : komorebic focus-workspace 3  # Ir para o workspace 4
win + 5              : komorebic focus-workspace 4  # Ir para o workspace 5
win + 6              : komorebic focus-workspace 5  # Ir para o workspace 6
win + 7              : komorebic focus-workspace 6  # Ir para o workspace 7
win + 8              : komorebic focus-workspace 7  # Ir para o workspace 8
win + 9              : komorebic focus-workspace 8  # Ir para o workspace 9
win + 0              : komorebic focus-workspace 9  # Ir para o workspace 10

# Mover a janela e ir junto (Win+Shift+número)
win + shift + 1      : komorebic move-to-workspace 0  # Levar janela ao workspace 1
win + shift + 2      : komorebic move-to-workspace 1  # Levar janela ao workspace 2
win + shift + 3      : komorebic move-to-workspace 2  # Levar janela ao workspace 3
win + shift + 4      : komorebic move-to-workspace 3  # Levar janela ao workspace 4
win + shift + 5      : komorebic move-to-workspace 4  # Levar janela ao workspace 5
win + shift + 6      : komorebic move-to-workspace 5  # Levar janela ao workspace 6
win + shift + 7      : komorebic move-to-workspace 6  # Levar janela ao workspace 7
win + shift + 8      : komorebic move-to-workspace 7  # Levar janela ao workspace 8
win + shift + 9      : komorebic move-to-workspace 8  # Levar janela ao workspace 9
win + shift + 0      : komorebic move-to-workspace 9  # Levar janela ao workspace 10

# Mover a janela sem ir junto (Win+Ctrl+Shift+número)
win + ctrl + shift + 1 : komorebic send-to-workspace 0  # Enviar janela ao workspace 1
win + ctrl + shift + 2 : komorebic send-to-workspace 1  # Enviar janela ao workspace 2
win + ctrl + shift + 3 : komorebic send-to-workspace 2  # Enviar janela ao workspace 3
win + ctrl + shift + 4 : komorebic send-to-workspace 3  # Enviar janela ao workspace 4
win + ctrl + shift + 5 : komorebic send-to-workspace 4  # Enviar janela ao workspace 5
win + ctrl + shift + 6 : komorebic send-to-workspace 5  # Enviar janela ao workspace 6
win + ctrl + shift + 7 : komorebic send-to-workspace 6  # Enviar janela ao workspace 7
win + ctrl + shift + 8 : komorebic send-to-workspace 7  # Enviar janela ao workspace 8
win + ctrl + shift + 9 : komorebic send-to-workspace 8  # Enviar janela ao workspace 9
win + ctrl + shift + 0 : komorebic send-to-workspace 9  # Enviar janela ao workspace 10

# --- komorebi / whkd ---
win + shift + r      : komorebic reload-configuration  # Recarregar config do komorebi
win + shift + p      : komorebic toggle-pause  # Pausar/retomar o komorebi
win + o              : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden  # Reiniciar o whkd
