.shell pwsh

# Keys follow omarchy, with Super mapped to Alt.

# --- Apps ---
alt + return         : start wt
alt + shift + return : start msedge
alt + shift + b      : start msedge
alt + ctrl + return  : start "$env:LOCALAPPDATA\Programs\herdr-app\herdr-app.exe"
alt + shift + f      : start explorer
alt + shift + n      : start wt nvim
alt + shift + t      : windots-launch-or-focus-tui --float btop
alt + shift + oem_2  : windots-launch-or-focus --float '^(omapass)$' "$env:LOCALAPPDATA\Programs\omapass\omapass.exe"  # "/" on US / US-Intl (ABNT2: windots-hotkeys.ahk)

# --- Tema e menus (omarchy: Super+Ctrl+T, Super+Ctrl+W, Super+K) ---
alt + ctrl + t       : windots-toggle-dark-mode
alt + ctrl + w       : start ms-settings:personalization-background
alt + k              : windots-menu-keybindings

# --- Captura (Print abre o recorte nativo do Windows) ---
alt + ctrl + shift + c : start ms-screenclip:

# --- Janelas ---
alt + w              : komorebic close
alt + q              : komorebic close
alt + f              : komorebic toggle-monocle
alt + t              : komorebic toggle-float
alt + j              : komorebic flip-layout horizontal
alt + shift + j      : komorebic flip-layout vertical
alt + m              : komorebic minimize
alt + e              : komorebic retile

# --- Foco (Alt+setas) ---
alt + left           : komorebic focus left
alt + right          : komorebic focus right
alt + up             : komorebic focus up
alt + down           : komorebic focus down

# --- Trocar janelas de lugar (Alt+Shift+setas) ---
alt + shift + left   : komorebic move left
alt + shift + right  : komorebic move right
alt + shift + up     : komorebic move up
alt + shift + down   : komorebic move down

# --- Redimensionar (Alt+-/= na largura, Alt+Shift+-/= na altura) ---
alt + oem_minus         : komorebic resize-axis horizontal decrease
alt + oem_plus          : komorebic resize-axis horizontal increase
alt + shift + oem_minus : komorebic resize-axis vertical decrease
alt + shift + oem_plus  : komorebic resize-axis vertical increase

# --- Workspaces ---
alt + tab            : komorebic cycle-workspace next
alt + shift + tab    : komorebic cycle-workspace previous

alt + 1              : komorebic focus-workspace 0
alt + 2              : komorebic focus-workspace 1
alt + 3              : komorebic focus-workspace 2
alt + 4              : komorebic focus-workspace 3
alt + 5              : komorebic focus-workspace 4
alt + 6              : komorebic focus-workspace 5
alt + 7              : komorebic focus-workspace 6
alt + 8              : komorebic focus-workspace 7
alt + 9              : komorebic focus-workspace 8
alt + 0              : komorebic focus-workspace 9

# Mover a janela e ir junto (Alt+Shift+número)
alt + shift + 1      : komorebic move-to-workspace 0
alt + shift + 2      : komorebic move-to-workspace 1
alt + shift + 3      : komorebic move-to-workspace 2
alt + shift + 4      : komorebic move-to-workspace 3
alt + shift + 5      : komorebic move-to-workspace 4
alt + shift + 6      : komorebic move-to-workspace 5
alt + shift + 7      : komorebic move-to-workspace 6
alt + shift + 8      : komorebic move-to-workspace 7
alt + shift + 9      : komorebic move-to-workspace 8
alt + shift + 0      : komorebic move-to-workspace 9

# Mover a janela sem ir junto (Alt+Ctrl+Shift+número)
alt + ctrl + shift + 1 : komorebic send-to-workspace 0
alt + ctrl + shift + 2 : komorebic send-to-workspace 1
alt + ctrl + shift + 3 : komorebic send-to-workspace 2
alt + ctrl + shift + 4 : komorebic send-to-workspace 3
alt + ctrl + shift + 5 : komorebic send-to-workspace 4
alt + ctrl + shift + 6 : komorebic send-to-workspace 5
alt + ctrl + shift + 7 : komorebic send-to-workspace 6
alt + ctrl + shift + 8 : komorebic send-to-workspace 7
alt + ctrl + shift + 9 : komorebic send-to-workspace 8
alt + ctrl + shift + 0 : komorebic send-to-workspace 9

# --- komorebi / whkd ---
alt + shift + r      : komorebic reload-configuration
alt + shift + p      : komorebic toggle-pause
alt + o              : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden
