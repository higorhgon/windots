diff --git a/src/windows/anchors.rs b/src/windows/anchors.rs
new file mode 100644
index 0000000..6170be2
--- /dev/null
+++ b/src/windows/anchors.rs
@@ -0,0 +1,93 @@
+//! windots patch: where the Start button and the tray are inside a taskbar.
+//!
+//! Windows 11 draws both in XAML, so they have no window handle: UI Automation is the way to find them
+//! (`StartButton` and the `SystemTrayIcon` items). The answer is cached and refreshed by a thread every
+//! couple of seconds, because the tray grows and shrinks and the Start button moves with the taskbar alignment.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::Duration;
+
+use windows::Win32::Foundation::{HWND, RECT};
+use windows::Win32::System::Com::{
+	CoCreateInstance, CoInitializeEx, CLSCTX_INPROC_SERVER, COINIT_MULTITHREADED,
+};
+use windows::Win32::UI::Accessibility::{
+	CUIAutomation, IUIAutomation, IUIAutomationElement, TreeScope_Descendants,
+};
+use windows::Win32::UI::WindowsAndMessaging::GetWindowRect;
+
+/// Positions inside the taskbar, in pixels from its left edge.
+#[derive(Debug, Clone, Copy, Default, PartialEq)]
+pub struct Anchors {
+	/// Left and right edge of the Start button.
+	pub start: Option<(i32, i32)>,
+	/// Left edge of the first icon of the tray (the hidden icons chevron).
+	pub tray_left: Option<i32>,
+}
+
+static CACHE: OnceLock<Mutex<HashMap<isize, Anchors>>> = OnceLock::new();
+
+/// The last anchors found for this taskbar; the first call starts the thread that keeps them fresh.
+pub fn get(taskbar: HWND) -> Anchors {
+	let key = taskbar.0 as isize;
+	let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+	let mut map = cache.lock().unwrap();
+	if let Some(found) = map.get(&key) {
+		return *found;
+	}
+	map.insert(key, Anchors::default());
+	drop(map);
+
+	std::thread::spawn(move || {
+		let hwnd = HWND(key as *mut _);
+		unsafe {
+			let _ = CoInitializeEx(None, COINIT_MULTITHREADED);
+		}
+		loop {
+			match unsafe { query(hwnd) } {
+				Ok(found) => {
+					if let Some(map) = CACHE.get() {
+						map.lock().unwrap().insert(key, found);
+					}
+				}
+				Err(e) => tracing::debug!("Taskbar anchors not found: {e}"),
+			}
+			std::thread::sleep(Duration::from_secs(2));
+		}
+	});
+	Anchors::default()
+}
+
+unsafe fn query(taskbar: HWND) -> windows::core::Result<Anchors> {
+	let ui: IUIAutomation = CoCreateInstance(&CUIAutomation, None, CLSCTX_INPROC_SERVER)?;
+	let root = ui.ElementFromHandle(taskbar)?;
+
+	let mut origin = RECT::default();
+	GetWindowRect(taskbar, &mut origin)?;
+
+	// The taskbar has a few dozen elements: take them all and look at the AutomationId of each one.
+	let all = root.FindAll(TreeScope_Descendants, &ui.CreateTrueCondition()?)?;
+	let mut found = Anchors::default();
+	let mut tray_left: Option<i32> = None;
+	for i in 0..all.Length()? {
+		let item: IUIAutomationElement = all.GetElement(i)?;
+		let id = item.CurrentAutomationId().map(|s| s.to_string()).unwrap_or_default();
+		if id != "StartButton" && id != "SystemTrayIcon" {
+			continue;
+		}
+		let r = item.CurrentBoundingRectangle()?;
+		if r.right <= r.left {
+			continue;
+		}
+		let (left, right) = (r.left - origin.left, r.right - origin.left);
+		if id == "StartButton" {
+			found.start = Some((left, right));
+		} else {
+			tray_left = Some(tray_left.map_or(left, |c| c.min(left)));
+		}
+	}
+	found.tray_left = tray_left;
+
+	Ok(found)
+}
